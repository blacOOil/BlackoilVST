{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build NewProject (Debug)",
            "type": "shell",
            "command": "make",
            "args": [ "CONFIG=Debug", "-j$(nproc)" ],
            "options": {
                "cwd": "${workspaceFolder}/Builds/LinuxMakefile"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [ "$gcc" ]
        },
        {
            "label": "Build NewProject (Release)",
            "type": "shell",
            "command": "make",
            "args": [ "CONFIG=Release", "-j$(nproc)" ],
            "options": {
                "cwd": "${workspaceFolder}/Builds/LinuxMakefile"
            },
            "group": "build",
            "problemMatcher": [ "$gcc" ]
        },
        {
            "label": "Clean NewProject",
            "type": "shell",
            "command": "make",
            "args": [ "clean" ],
            "options": {
                "cwd": "${workspaceFolder}/Builds/LinuxMakefile"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Run NewProject",
            "type": "shell",
            "command": "${workspaceFolder}/run.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [ "$gcc" ]
        }
    ]
}
